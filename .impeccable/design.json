  "narrative": {
    "northStar": "Research poster",
    "overview": "The research poster uses a wide reading surface, a strong masthead rule, open research columns, and figures from the papers. Fraunces gives names and research questions their hierarchy; Source Sans 3 carries complete scholarly metadata and prose.\n\nThe shared shell has static text navigation and a persistent light/dark theme switch. Research, bibliography, writing, and study pages use the same typography, colors, rules, and figure treatment with widths suited to their content. The approved direction is A, research poster; the proposed novel interactions were rejected.",
    "keyCharacteristics": [
      "Open columns, thin dividers, and a strong masthead rule.",
      "Fraunces headings, Source Sans 3 text, and the retained circular portrait.",
      "Existing research figures with captions, paper links, and full-size access."
    ],
    "rules": [
      {
        "name": "The Theme Pair Rule",
        "body": "Resolve interactive colors through the existing light and dark theme variables.",
        "section": "colors"
      },
      {
        "name": "The Reading Hierarchy Rule",
        "body": "Use serif type for names and research headings; use sans serif type for publication titles, metadata, and controls.",
        "section": "typography"
      },
      {
        "name": "The Open Surface Rule",
        "body": "Separate research and publication groups with spacing and thin rules.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain the established fonts, portrait, and light/dark theme pairing.",
      "Do preserve full author lists and wrap scholarly metadata within the available column.",
      "Do use visible keyboard focus, native controls, and readable content without JavaScript.",
      "Do keep paper figures uncropped on white with captions and full-size links."
    ],
    "donts": [
      "Don't introduce container cards, decorative animation, or novel interactions into the approved poster direction.",
      "Don't present synthetic illustration values as paper measurements or a live model.",
      "Don't copy obsolete fixed navigation, collapsed mobile menus, or the superseded 880px shell into new academic surfaces."
    ]
  }
}
